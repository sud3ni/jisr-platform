          "OPPORTUNITIES COUNT:",
          opportunityCount
        );

        setOpportunities(
          (opportunitiesData || []) as Opportunity[]
        );

        setOpportunitiesCount(
          opportunityCount ??
            opportunitiesData?.length ??
            0
        );
      }

      /*
       * ================================
       * INSTITUTIONS
       * ================================
       */

      const {
        count: institutionCount,
        error: institutionsError,
      } = await supabase
        .from("institutions")
        .select("id", {
          count: "exact",
          head: true,
        });

      if (institutionsError) {
        console.error(
          "INSTITUTIONS ERROR:",
          institutionsError
        );
      }

      setInstitutionsCount(
        institutionCount ?? 0
      );

      /*
       * ================================
       * USERS
       * ================================
       */

      const {
        count: userCount,
        error: usersError,
      } = await supabase
        .from("users")
        .select("id", {
          count: "exact",
          head: true,
        })
        .in("role", [
          "student",
          "graduate",
        ]);

