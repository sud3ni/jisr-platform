    setLoading(true);

    try {
      /*
       * ================================
       * OPPORTUNITIES
       * ================================
       */

      const {
        data: opportunitiesData,
        count: opportunityCount,
        error: opportunitiesError,
      } = await supabase
        .from("opportunities")
        .select(
          "id,title,opportunity_type,city,state,status,created_at",
          {
            count: "exact",
          }
        )
        .eq("status", "published")
        .order("created_at", {
          ascending: false,
        })
        .limit(6);

      if (opportunitiesError) {
        console.error(
          "OPPORTUNITIES ERROR:",
          opportunitiesError
        );

        setOpportunities([]);
        setOpportunitiesCount(0);
      } else {
        console.log(
          "OPPORTUNITIES DATA:",
          opportunitiesData
        );

